MONGODB_URI=
PORT=5000
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dual signup
OFFICE_INVITE_CODE=office-demo-2026
# Optional comma-separated domains for office accounts, e.g. company.com,corp.org
ALLOWED_OFFICE_DOMAINS=
# Return OTP in API response when SMTP is missing (local/dev only)
DEV_RETURN_OTP=true

# SMTP for signup verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=12000

# Recommended on Railway (avoids Gmail SMTP hang): https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=RocketMessage <onboarding@resend.dev>
